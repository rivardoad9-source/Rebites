# ── Google Sheets Two-Way Sync ────────────────────────────────────────────
# Ambil dari URL spreadsheet: docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Service account (Google Cloud Console -> IAM -> Service Accounts -> Keys -> JSON).
# Jangan lupa Share spreadsheet ke email service account ini sebagai Editor.
GOOGLE_CLIENT_EMAIL=mango-pos@project-id.iam.gserviceaccount.com

# Salin isi field "private_key" dari file JSON, apa adanya (termasuk \n).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Opsional: kunci webhook Google Apps Script. Kalau diisi, POST /api/sync wajib
# menyertakan header x-sync-secret / query ?secret= dengan nilai yang sama.
SYNC_SECRET=

# Opsional: kunci dashboard dengan password. Kosongkan kalau tidak mau dikunci
# (mis. saat `npm run dev`). Password tidak pernah ditulis di kode.
APP_PASSWORD=
